@model List<GourmetReserve.Models.Table>
@{
    ViewData["Title"] = "Бронирование стола";
}

<link rel="stylesheet" href="~/css/booking.css" />

<div class="container my-4">
    <h1 class="mb-4">Бронирование стола</h1>

    @* ---------- Форма выбора даты и времени ---------- *@
    <form id="bookingForm" class="row g-3 mb-4">
        @Html.AntiForgeryToken()

        <div class="col-md-3">
            <label for="bookingDate" class="form-label">Дата</label>
            <input type="date" id="bookingDate" name="Date" class="form-control" required
                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-md-3">
            <label for="bookingTime" class="form-label">Время</label>
            <input type="time" id="bookingTime" name="Time" class="form-control" required />
        </div>

        <div class="col-md-3">
            <label for="guestsCount" class="form-label">Количество гостей</label>
            <input type="number" id="guestsCount" name="GuestsCount" class="form-control"
                   min="1" max="20" value="2" required />
        </div>

        <div class="col-md-3 d-flex align-items-end">
            <div id="selectionStatus" class="text-muted">Выберите дату, время и стол ниже</div>
        </div>

        <hr class="mt-4" />

        <div class="col-md-4">
            <label for="guestName" class="form-label">Имя</label>
            <input type="text" id="guestName" name="GuestName" class="form-control" required />
        </div>

        <div class="col-md-4">
            <label for="phone" class="form-label">Телефон</label>
            <input type="tel" id="phone" name="Phone" class="form-control" required />
        </div>

        <div class="col-md-4">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="Email" class="form-control" />
        </div>

        <div class="col-12">
            <label for="specialRequests" class="form-label">Особые пожелания</label>
            <textarea id="specialRequests" name="SpecialRequests" class="form-control" rows="2"></textarea>
        </div>

        @* Скрытое поле, куда JS запишет ID выбранного стола *@
        <input type="hidden" id="selectedTableId" name="TableId" value="" />
    </form>

    @* ---------- Карта зала ---------- *@
    <h2 class="h4 mb-3">Схема зала</h2>
    <div class="restaurant-floor">
        @foreach (var table in Model)
        {
            <button type="button"
                    class="table-item"
                    data-table-id="@table.Id"
                    data-capacity="@table.Capacity"
                    style="grid-row: @table.GridRow; grid-column: @table.GridColumn;"
                    title="Стол №@table.TableNumber · @table.Capacity мест · @table.Location">
                <span class="table-icon">🍽️</span>
                <span class="table-label">№@table.TableNumber</span>
                <span class="table-capacity">@table.Capacity мест</span>
            </button>
        }
    </div>

    <div class="mt-3 d-flex gap-3 legend">
        <span><span class="legend-swatch legend-free"></span> Свободен</span>
        <span><span class="legend-swatch legend-selected"></span> Выбран</span>
        <span><span class="legend-swatch legend-busy"></span> Занят</span>
    </div>

    <button id="confirmBookingBtn" class="btn btn-success mt-4" disabled>
        Подтвердить бронирование
    </button>

    <div id="bookingResult" class="mt-3"></div>
</div>

@section Scripts {
    <script src="~/js/booking.js"></script>
}
