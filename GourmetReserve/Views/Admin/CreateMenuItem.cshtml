@model MenuItem
@{
    ViewData["Title"] = "Новое блюдо";
}

<h1 class="h3 mb-4">Новое блюдо</h1>

<form asp-action="CreateMenuItem" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @await Html.PartialAsync("_MenuItemFormFields")
    <button type="submit" class="btn btn-dark">Сохранить</button>
    <a asp-action="MenuItems" class="btn btn-outline-secondary">Отмена</a>
</form>
