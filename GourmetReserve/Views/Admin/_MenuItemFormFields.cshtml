@model MenuItem

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MenuCategoryId" class="form-label"></label>
        <select asp-for="MenuCategoryId" class="form-select"
                asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
            <option value="">— выберите категорию —</option>
        </select>
        <span asp-validation-for="MenuCategoryId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>

    <div class="col-md-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="WeightOrVolume" class="form-label"></label>
        <input asp-for="WeightOrVolume" class="form-control" placeholder="напр. 250 г" />
    </div>

    <div class="col-md-3">
        <label asp-for="ImageFileName" class="form-label"></label>
        <input asp-for="ImageFileName" class="form-control" placeholder="dish.jpg" />
    </div>

    <div class="col-md-3 d-flex flex-column justify-content-end gap-2">
        <div class="form-check">
            <input asp-for="IsSpicy" class="form-check-input" />
            <label asp-for="IsSpicy" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="IsVegetarian" class="form-check-input" />
            <label asp-for="IsVegetarian" class="form-check-label"></label>
        </div>
        <div class="form-check">
            <input asp-for="IsChefChoice" class="form-check-input" />
            <label asp-for="IsChefChoice" class="form-check-label"></label>
        </div>
    </div>
</div>

<hr class="my-4" />
