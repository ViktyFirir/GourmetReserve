@model NewsItem
@{
    ViewData["Title"] = "Редактирование новости";
}

<h1 class="h3 mb-4">Редактирование новости</h1>

<form asp-action="EditNewsItem" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @await Html.PartialAsync("_NewsItemFormFields")
    <button type="submit" class="btn btn-dark">Сохранить</button>
    <a asp-action="NewsItems" class="btn btn-outline-secondary">Отмена</a>
</form>
